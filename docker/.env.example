# Example environment variables for docker-compose
# OPENSCIENCE_BIN_PATH: path inside the container of the native OpenScience
#   binary. Defaults to the binary baked into the image
#   (/usr/local/bin/openscience-native). Set it to override, e.g. to mount your
#   own build.
OPENSCIENCE_BIN_PATH=/usr/local/bin/openscience-native

# OPENSCIENCE_INSTALL_SKILL_DEPS: set to 1 to pre-install every skill's declared
#   Python dependencies (torch, transformers, vllm, ...) at container startup.
#   This is slow and mostly unnecessary - install only what you need on demand.
OPENSCIENCE_INSTALL_SKILL_DEPS=0

# SANDBOX_PORT: unique host port for the web UI. The openscience server listens
#   only on 127.0.0.1 inside its own namespace; the entrypoint runs a socat proxy
#   that binds this port on the container interface and forwards to it. Pick a
#   port that is free on your machine (8080 is commonly taken).
SANDBOX_PORT=18080